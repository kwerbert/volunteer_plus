# ── Секреты ──────────────────────────────────────────────
JWT_SECRET_KEY=put-a-long-random-string-here
SERVICE_API_KEY=put-another-long-random-string-here

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=volunteer
POSTGRES_PASSWORD=volunteer_secret_change_me
POSTGRES_DB=volunteer_plus

# Строка подключения для сервисов (внутри docker-сети)
DATABASE_URL=postgresql+asyncpg://volunteer:volunteer_secret_change_me@postgres:5432/volunteer_plus

# ── Разное ───────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
