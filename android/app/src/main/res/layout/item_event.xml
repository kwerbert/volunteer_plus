<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    style="@style/CardStyle.White">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Название мероприятия -->
        <TextView
            android:id="@+id/tv_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название мероприятия"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <!-- Организация (ОШИБКА БЫЛА ЗДЕСЬ: tv_organization_name) -->
        <TextView
            android:id="@+id/tv_organization_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Организация"
            android:textColor="@color/secondary"
            android:layout_marginBottom="4dp"/>

        <!-- Время (ОШИБКА БЫЛА ЗДЕСЬ: tv_event_time) -->
        <TextView
            android:id="@+id/tv_event_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 мая 2026 • 10:00"
            android:textColor="@color/secondary"
            android:textSize="14sp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>