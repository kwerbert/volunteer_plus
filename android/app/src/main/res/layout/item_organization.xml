<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    style="@style/CardStyle.White">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Аватар организации -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_org_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circle"
            android:importantForAccessibility="no" />

        <!-- Контент (текст + кнопки) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_org_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название организации"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_org_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Описание организации"
                android:textColor="@color/secondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_org_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 4.0"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_subscribe"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Подписаться"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Написать"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>