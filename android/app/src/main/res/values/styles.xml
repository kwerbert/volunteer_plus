<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearanceOverlay.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Стиль для карточек с фиксированным белым фоном -->
    <style name="CardStyle.White" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- ИСПРАВЛЕНО: Стиль для SearchView с правильными цветами текста -->
    <style name="SearchView.WhiteBackground" parent="Widget.AppCompat.SearchView">
        <item name="android:background">@drawable/search_background</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
        <!-- Цвет текста запроса -->
        <item name="android:textColor">@color/search_text</item>
        <item name="android:textColorHint">@color/search_hint</item>
        <!-- Цвет иконки поиска -->
        <item name="searchHintIcon">@null</item>
    </style>

    <!-- НОВЫЙ СТИЛЬ ДЛЯ КНОПОК С УВЕЛИЧЕННЫМ ТЕКСТОМ -->
    <style name="ButtonStyle.Large" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Стиль для текстовых кнопок (как в пустом состоянии) -->
    <style name="ButtonStyle.Large.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>