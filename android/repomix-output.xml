package com.example.myapplication.network

import com.example.myapplication.BuildConfig
import com.example.myapplication.data.api.AuthApi
import com.example.myapplication.data.api.RefreshTokenRequest
import com.example.myapplication.util.Constants
import com.example.myapplication.util.JwtUtils
import com.example.myapplication.util.SessionManager
import kotlinx.coroutines.runBlocking
import kotlinx.coroutines.withTimeoutOrNull
import okhttp3.Interceptor
import okhttp3.Response
import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class AuthInterceptor @Inject constructor(
    private val sessionManager: SessionManager
) : Interceptor {

    private var isRefreshing = false
    private var newToken: String? = null

    private val refreshRetrofit: Retrofit by lazy {
        Retrofit.Builder()
            .baseUrl(Constants.USER_SERVICE_URL)
            .addConverterFactory(GsonConverterFactory.create())
            .build()
    }

    private val refreshAuthApi: AuthApi by lazy {
        refreshRetrofit.create(AuthApi::class.java)
    }

    override fun intercept(chain: Interceptor.Chain): Response {
        val original = chain.request()
        val requestUrl = original.url.toString()
        if (requestUrl.contains("/auth/login") ||
            requestUrl.contains("/auth/register") ||
            requestUrl.contains("/auth/refresh")) {
            return chain.proceed(original)
        }

        val token = getEffectiveToken()
        val requestWithAuth = if (!token.isNullOrEmpty()) {
            original.newBuilder()
                .header("Authorization", "Bearer $token")
                .build()
        } else {
            original
        }

        var response = chain.proceed(requestWithAuth)

        if (response.code == 401 && !requestUrl.contains("/auth/logout")) {
            synchronized(this) {
                if (!isRefreshing) {
                    isRefreshing = true
                    try {
                        val newAccessToken = refreshToken()
                        if (newAccessToken != null) {
                            newToken = newAccessToken
                            response.close()
                            val newRequest = original.newBuilder()
                                .header("Authorization", "Bearer $newAccessToken")
                                .build()
                            response = chain.proceed(newRequest)
                        } else {
                            sessionManager.clear()
                        }
                    } finally {
                        isRefreshing = false
                    }
                } else {
                    // Ожидаем завершения refresh с ограничением по времени
                    var retries = 0
                    while (newToken == null && retries < 10) {
                        Thread.sleep(100)
                        retries++
                    }
                    if (newToken != null) {
                        response.close()
                        val newRequest = original.newBuilder()
                            .header("Authorization", "Bearer $newToken")
                            .build()
                        response = chain.proceed(newRequest)
                    }
                }
            }
        }
        return response
    }

    private fun refreshToken(): String? {
        val refreshToken = sessionManager.refreshToken ?: return null
        return try {
            val response = runBlocking {
                withTimeoutOrNull(5000L) {
                    refreshAuthApi.refreshToken(RefreshTokenRequest(refreshToken))
                }
            }
            if (response?.isSuccessful == true && response.body() != null) {
                val tokens = response.body()!!
                val newRole = JwtUtils.extractRole(tokens.accessToken)
                sessionManager.saveAuthData(
                    accessToken = tokens.accessToken,
                    refreshToken = tokens.refreshToken,
                    userId = tokens.userId,
                    expiresIn = tokens.expiresIn,
                    role = newRole
                )
                tokens.accessToken
            } else {
                null
            }
        } catch (e: Exception) {
            null
        }
    }

    private fun getEffectiveToken(): String? {
        // Убираем фейковый токен – только реальный
        return sessionManager.accessToken
    }
}
</file>

<file path="app/src/main/java/com/example/myapplication/network/WebSocketManager.kt">
package com.example.myapplication.network

import android.util.Log
import com.example.myapplication.util.Constants
import com.google.gson.Gson
import kotlinx.coroutines.flow.MutableSharedFlow
import kotlinx.coroutines.flow.SharedFlow
import kotlinx.coroutines.flow.asSharedFlow
import okhttp3.*
import okhttp3.logging.HttpLoggingInterceptor
import java.util.concurrent.TimeUnit
import com.example.myapplication.BuildConfig
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class WebSocketManager @Inject constructor(
    private val authInterceptor: AuthInterceptor
) {

    private val client: OkHttpClient = OkHttpClient.Builder()
        .addInterceptor(authInterceptor)
        .addInterceptor(HttpLoggingInterceptor().apply {
            level = if (BuildConfig.DEBUG) HttpLoggingInterceptor.Level.BODY else HttpLoggingInterceptor.Level.NONE
        })
        .connectTimeout(10, TimeUnit.SECONDS)
        .writeTimeout(10, TimeUnit.SECONDS)
        .readTimeout(10, TimeUnit.SECONDS)
        .build()

    private var currentWebSocket: WebSocket? = null
    private val _incomingMessages = MutableSharedFlow<MessagePayload>(extraBufferCapacity = 64)
    val incomingMessages: SharedFlow<MessagePayload> = _incomingMessages.asSharedFlow()

    data class MessagePayload(
        val id: Int,
        val chatId: Int,
        val senderId: Int,
        val content: String,
        val messageType: String,
        val attachmentUrl: String?,
        val isRead: Boolean,
        val createdAt: String,
        val updatedAt: String?
    )

    fun connect(chatId: Int, token: String) {
        if (currentWebSocket != null) {
            Log.d("WebSocketManager", "Already connected to chat $chatId")
            return
        }
        val url = "${Constants.CHAT_WS_BASE_URL}$chatId?token=$token"
        val request = Request.Builder().url(url).build()
        currentWebSocket = client.newWebSocket(request, object : WebSocketListener() {
            override fun onOpen(webSocket: WebSocket, response: Response) {
                Log.d("WebSocketManager", "Connected to chat $chatId")
            }

            override fun onMessage(webSocket: WebSocket, text: String) {
                try {
                    val payload = Gson().fromJson(text, MessagePayload::class.java)
                    _incomingMessages.tryEmit(payload) // Отправка в SharedFlow
                } catch (e: Exception) {
                    Log.e("WebSocketManager", "Failed to parse message", e)
                }
            }

            override fun onClosing(webSocket: WebSocket, code: Int, reason: String) {
                Log.d("WebSocketManager", "Closing connection: $reason")
            }

            override fun onClosed(webSocket: WebSocket, code: Int, reason: String) {
                currentWebSocket = null
                Log.d("WebSocketManager", "Closed: $reason")
            }

            override fun onFailure(webSocket: WebSocket, t: Throwable, response: Response?) {
                Log.e("WebSocketManager", "WebSocket error", t)
                currentWebSocket = null
            }
        })
    }

    fun disconnect() {
        currentWebSocket?.close(1000, "Normal closure")
        currentWebSocket = null
    }

    fun sendMessage(content: String) {
        currentWebSocket?.send(content)
    }
}
</file>

<file path="app/src/main/java/com/example/myapplication/ui/activities/ChatActivity.kt">
package com.example.myapplication.ui.activities

import android.os.Bundle
import android.view.View
import android.widget.Toast
import androidx.activity.viewModels
import androidx.appcompat.app.AppCompatActivity
import androidx.lifecycle.lifecycleScope
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView
import com.example.myapplication.databinding.ActivityChatBinding
import com.example.myapplication.ui.adapters.ChatListAdapter
import com.example.myapplication.ui.adapters.MessageListAdapter
import com.example.myapplication.ui.viewmodels.ChatUiEvent
import com.example.myapplication.ui.viewmodels.ChatUiState
import com.example.myapplication.ui.viewmodels.ChatViewModel
import dagger.hilt.android.AndroidEntryPoint
import kotlinx.coroutines.launch

@AndroidEntryPoint
class ChatActivity : AppCompatActivity() {
    companion object {
        const val EXTRA_CHAT_ID = "chat_id"
        const val EXTRA_CHAT_TITLE = "chat_title"
        const val EXTRA_ORG_ID = "org_id"
        const val EXTRA_EVENT_ID = "event_id"
        const val EXTRA_CHAT_TYPE = "chat_type"
        const val EXTRA_SHOW_ORGANIZER_CHATS = "show_organizer_chats"
    }

    private var _binding: ActivityChatBinding? = null
    private val binding get() = _binding!!

    private enum class UIMode { LIST, CHAT }

    private val viewModel: ChatViewModel by viewModels()
    private lateinit var messageAdapter: MessageListAdapter
    private lateinit var chatListAdapter: ChatListAdapter
    private var chatId: Int = -1
    private var currentMode: UIMode = UIMode.CHAT

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        _binding = ActivityChatBinding.inflate(layoutInflater)
        setContentView(binding.root)

        setupToolbar("Чаты")
        initAdapters()
        setupRecyclerView()
        setupPagination()

        val showOrganizerChats = intent.getBooleanExtra(EXTRA_SHOW_ORGANIZER_CHATS, false)
        val orgId = intent.getIntExtra(EXTRA_ORG_ID, -1)
        val eventId = intent.getIntExtra(EXTRA_EVENT_ID, -1)
        val explicitChatId = intent.getIntExtra(EXTRA_CHAT_ID, -1)
        val chatTitle = intent.getStringExtra(EXTRA_CHAT_TITLE) ?: "Чат"

        when {
            showOrganizerChats -> {
                switchToMode(UIMode.LIST)
                viewModel.loadChats()
            }
            orgId != -1 -> {
                createOrganizerChat(orgId)
            }
            eventId != -1 -> {
                viewModel.createEventChat(eventId)
                switchToMode(UIMode.CHAT)
            }
            explicitChatId != -1 -> {
                chatId = explicitChatId
                setupToolbar(chatTitle)
                switchToMode(UIMode.CHAT)
                viewModel.selectChat(chatId)
            }
            else -> {
                Toast.makeText(this, "Некорректный запрос на открытие чата", Toast.LENGTH_SHORT).show()
                finish()
            }
        }
        observeViewModel()
        setupSendButton()
    }

    private fun initAdapters() {
        messageAdapter = MessageListAdapter()
        chatListAdapter = ChatListAdapter { chat ->
            chatId = chat.id
            viewModel.selectChat(chatId)
            setupToolbar(chat.title ?: "Чат с организатором")
            switchToMode(UIMode.CHAT)
        }
    }

    private fun setupRecyclerView() {
        binding.rvMessages.layoutManager = LinearLayoutManager(this).apply {
            stackFromEnd = true
        }
        binding.rvMessages.adapter = messageAdapter
    }

    private fun setupPagination() {
        binding.rvMessages.addOnScrollListener(object : RecyclerView.OnScrollListener() {
            override fun onScrolled(recyclerView: RecyclerView, dx: Int, dy: Int) {
                val layoutManager = recyclerView.layoutManager as LinearLayoutManager
                val firstVisiblePosition = layoutManager.findFirstVisibleItemPosition()
                // При скролле вверх и приближении к началу (1-й или 2-й элемент)
                if (firstVisiblePosition <= 1 && dy < 0) {
                    viewModel.loadMoreMessages()
                }
            }
        })
    }

    private fun switchToMode(mode: UIMode) {
        currentMode = mode
        when (mode) {
            UIMode.LIST -> {
                binding.rvMessages.layoutManager = LinearLayoutManager(this)
                binding.rvMessages.adapter = chatListAdapter
                binding.etMessage.visibility = View.GONE
                binding.btnSend.visibility = View.GONE
                binding.tvEmptyListHint?.visibility = View.VISIBLE
            }
            UIMode.CHAT -> {
                binding.rvMessages.layoutManager = LinearLayoutManager(this).apply { stackFromEnd = true }
                binding.rvMessages.adapter = messageAdapter
                binding.etMessage.visibility = View.VISIBLE
                binding.btnSend.visibility = View.VISIBLE
                binding.tvEmptyListHint?.visibility = View.GONE
            }
        }
    }

    private fun createOrganizerChat(orgId: Int) {
        switchToMode(UIMode.LIST)
        viewModel.loadChats()
        viewModel.createOrganizerChat(orgId)
    }

    private fun setupToolbar(title: String) {
        setSupportActionBar(binding.toolbar)
        supportActionBar?.apply {
            setDisplayHomeAsUpEnabled(true)
            setDisplayShowHomeEnabled(true)
            this.title = title
        }
        binding.toolbar.setNavigationOnClickListener {
            finish()
        }
    }

    private fun setupSendButton() {
        binding.btnSend.setOnClickListener {
            val content = binding.etMessage.text.toString().trim()
            if (content.isNotEmpty()) {
                viewModel.sendMessage(content)
                binding.etMessage.text?.clear()
            }
        }
    }

    private fun observeViewModel() {
        lifecycleScope.launch {
            viewModel.uiState.collect { state ->
                when (state) {
                    is ChatUiState.Loading -> {
                        binding.progressBar.visibility = View.VISIBLE
                    }
                    is ChatUiState.Success -> {
                        binding.progressBar.visibility = View.GONE
                        when (currentMode) {
                            UIMode.LIST -> {
                                chatListAdapter.submitList(state.chats)
                                if (state.chats.isEmpty()) {
                                    binding.tvEmptyListHint?.visibility = View.VISIBLE
                                    binding.tvEmptyListHint?.text = "У вас пока нет активных чатов"
                                }
                            }
                            UIMode.CHAT -> {
                                messageAdapter.submitList(state.messages)
                                if (state.messages.isNotEmpty()) {
                                    binding.rvMessages.scrollToPosition(state.messages.size - 1)
                                }
                            }
                        }
                    }
                    is ChatUiState.Error -> {
                        binding.progressBar.visibility = View.GONE
                        Toast.makeText(this@ChatActivity, state.message, Toast.LENGTH_SHORT).show()
                    }
                }
            }
        }

        lifecycleScope.launch {
            viewModel.events.collect { event ->
                event?.let {
                    when (it) {
                        is ChatUiEvent.MessageSent -> {
                            binding.rvMessages.post {
                                binding.rvMessages.scrollToPosition(messageAdapter.itemCount - 1)
                            }
                        }
                        is ChatUiEvent.ChatCreated -> {
                            switchToMode(UIMode.LIST)
                            viewModel.loadChats()
                        }
                        is ChatUiEvent.OrganizerChatCreated -> {
                            setupToolbar("Чат с организатором")
                            setupRecyclerView()
                            setupSendButton()
                            viewModel.selectChat(it.chatId)
                            switchToMode(UIMode.CHAT)
                        }
                        is ChatUiEvent.ShowError -> {
                            Toast.makeText(this@ChatActivity, it.message, Toast.LENGTH_SHORT).show()
                        }
                        else -> {}
                    }
                }
            }
        }
    }

    override fun onResume() {
        super.onResume()
        if (chatId != -1 && currentMode == UIMode.CHAT) {
            viewModel.markChatAsRead(chatId)
        }
    }

    override fun onDestroy() {
        super.onDestroy()
        _binding = null
    }
}
</file>

